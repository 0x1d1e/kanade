#!/bin/sh
# frame gaps across the island's morphs (#36). Needs `KANADE_FRAMES=1 scripts/dev > LOG 2>&1` running
# usage: scripts/frames LOG [ROUNDS]; $KANADE is the CLI, target/debug/kanade by default
set -e
log=${1:?usage: scripts/frames LOG [ROUNDS]}
rounds=${2:-3}

measure() {
    label=$1
    shift
    start=$(wc -l < "$log")
    "${KANADE:-target/debug/kanade}" "$@" > /dev/null
    sleep 1
    tail -n +$((start + 1)) "$log" | awk -v label="$label" '
        $1 == "frame" {
            n++
            if (n > 1) { sum += $5; if ($5 > most) most = $5 }
            work = $7 + $9 + $11
            if (work > busiest) busiest = work
        }
        END {
            printf "%-10s frames %3d  mean gap %5.1f ms  max gap %5.1f ms  max view+draw+gpu %4.1f ms\n",
                label, n, (n > 1 ? sum / (n - 1) : 0), most, busiest
        }'
}

i=0
while [ "$i" -lt "$rounds" ]; do
    for surface in controls media notifications launcher calendar weather; do
        measure "$surface" "$surface" open
    done
    measure collapse island collapse
    i=$((i + 1))
done
