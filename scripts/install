#!/bin/sh
# installs Kanade: the binary, its shell completions, the systemd user unit, the icon, and on a fresh
# TTY install the desktop pieces and a default niri config. Run again to update. The unit is
# Kanade's own and is replaced (the old one kept as kanade.service.bak.DATE); change it with
# `systemctl --user edit kanade.service`. A niri config of yours is never replaced.
# The curl URL only reads this script from main. A piped run with no --ref downloads the Arch
# x86_64 binary from the install-0.1 release, or compiles release/0.1 if that asset is absent.
#   curl -fsSL https://raw.githubusercontent.com/0x1d1e/kanade/main/scripts/install | sh
#   curl -fsSL https://raw.githubusercontent.com/0x1d1e/kanade/main/scripts/install | sh -s -- --shell-only
#   curl -fsSL https://raw.githubusercontent.com/0x1d1e/kanade/main/scripts/install | sh -s -- --yes
#   curl -fsSL https://raw.githubusercontent.com/0x1d1e/kanade/main/scripts/install | sh -s -- --ref v0.1.0
# or scripts/install from a checkout, which builds that checkout. Options:
#     --optional    also the packages of the optional features
#     --shell-only  Kanade without the desktop packages or a niri config
#     --no-niri     skip the niri package and do not write a niri config
#     --niri        install the niri package even with --shell-only; still no niri config then
#     --sddm        install SDDM with niri, theme it, enable it for the next boot; do not start it
#     --sddm-greeter keep|niri   login screen display server, with --sddm (default keep, or niri on hybrid NVIDIA)
#     --uninstall   removes Kanade's binary, completions, unit, icon, build checkout and the root-owned SDDM
#                   files it wrote; configs, the unit's .bak copies and packages stay
#     --yes         skip the TUI; a piped run with a terminal otherwise execs kanade-install
#     --ref REF     compile that branch or tag instead of downloading install-0.1; refused from a checkout
set -eu

repo=https://github.com/0x1d1e/kanade
release=https://github.com/0x1d1e/kanade/releases/download/install-0.1
script_url=https://raw.githubusercontent.com/0x1d1e/kanade/main/scripts/install
usage='usage: install [--optional] [--shell-only] [--no-niri] [--niri] [--sddm] [--sddm-greeter keep|niri] [--uninstall] [--yes] [--ref REF]'

# one branch or tag name. Not empty, not an option, not a range, not a URL, not a shell word.
ref_ok() {
    case "$1" in
        "" | -* | *[!A-Za-z0-9._/+-]* | *..* | . | @ | */ | /* | *//* | *. | .* | */.* | *.lock | *.lock/* | */*.lock | */*.lock/*)
            return 1
            ;;
    esac
    return 0
}

# 0 saved, 2 missing (HTTP 404), 1 anything else. A short body is not a successful download.
fetch() {
    url=$1
    dest=$2
    rm -f "$dest"
    code=$(curl -sS -L --retry 2 -o "$dest" -w '%{http_code}' "$url") || code=000
    if [ "$code" = 200 ] && [ -s "$dest" ]; then
        return 0
    fi
    if [ "$code" = 200 ]; then
        echo "failed: $url is short" >&2
        rm -f "$dest"
        return 1
    fi
    rm -f "$dest"
    if [ "$code" = 404 ]; then
        return 2
    fi
    echo "failed to download $url (HTTP $code)" >&2
    return 1
}

# sha256sum -c, in the file's directory, so the name in the checksum file matches. A mismatch or a
# short file stops. Callers must not install, and must not fall back to compiling, after this fails.
verify() {
    file=$1
    sum=$2
    name=$(basename "$file")
    if [ ! -s "$file" ] || [ ! -s "$sum" ]; then
        echo "failed: $name is short or its checksum is short" >&2
        return 1
    fi
    size=$(wc -c < "$file")
    if [ "$size" -lt 1024 ]; then
        echo "failed: $name is short" >&2
        return 1
    fi
    dir=$(dirname "$file")
    sumname=$(basename "$sum")
    if ! (cd "$dir" && sha256sum -c "$sumname"); then
        echo "failed: $name checksum mismatch" >&2
        return 1
    fi
}

# same sentence as crates/install. Printed before any install.
refuse_machine() {
    machine=$(uname -m)
    if [ "$machine" != x86_64 ]; then
        echo "failed: this machine is $machine, Kanade's install binary is x86_64 only" >&2
        exit 1
    fi
}

# paru if it is already on PATH, otherwise yay if that is. Neither: pacman installs paru, then paru.
# The helper itself is never run under sudo. Scan prints the same helper: line before this runs.
ensure_helper() {
    if command -v paru > /dev/null; then
        echo "helper: paru"
        helper=paru
        return 0
    fi
    if command -v yay > /dev/null; then
        echo "helper: yay"
        helper=yay
        return 0
    fi
    echo "helper: none"
    if ! sudo pacman -S --needed --noconfirm paru || ! command -v paru > /dev/null; then
        echo "pacman could not install paru" >&2
        exit 1
    fi
    helper=paru
}

# Kanade's packages. Not pacman -S. compile=1 adds the build packages the fallback and --ref need.
install_packages() {
    packages="wayland libxkbcommon fontconfig freetype2 expat vulkan-icd-loader libpulse pam systemd dbus util-linux"
    if [ "$compile" = 1 ]; then
        packages="$packages git base-devel pkgconf"
        if ! command -v cargo > /dev/null; then
            packages="$packages rust"
        fi
    fi

    wallpaper=0
    if [ "$desktop" = 1 ] && { [ "$no_niri" = 0 ] || [ "$want_niri" = 1 ] || [ "$sddm" = 1 ]; }; then
        wallpaper=1
    fi
    if [ "$sddm" = 1 ] || [ "$want_niri" = 1 ]; then
        wallpaper=1
    fi
    if [ "$desktop" = 1 ]; then
        gpu=""
        for vendor in /sys/class/drm/card*/device/vendor; do
            [ -r "$vendor" ] || continue
            case "$(cat "$vendor")" in
                0x8086) gpu="$gpu vulkan-intel" ;;
                0x1002) gpu="$gpu vulkan-radeon" ;;
                # virgl gives the guest OpenGL only, so Kanade's Vulkan needs the CPU rasterizer there
                0x1af4) gpu="$gpu vulkan-virtio vulkan-swrast" ;;
                0x1234 | 0x15ad) gpu="$gpu vulkan-swrast" ;;
                0x10de) echo "note: install nvidia-utils or vulkan-nouveau yourself for the NVIDIA GPU" >&2 ;;
            esac
        done
        if [ -z "$gpu" ]; then
            echo "note: no Vulkan driver chosen, install the one for your GPU" >&2
        fi
        packages="$packages xdg-desktop-portal-gnome gnome-keyring polkit pipewire
            pipewire-pulse wireplumber noto-fonts noto-fonts-emoji inter-font kitty brightnessctl
            playerctl qt6ct xwayland-satellite $gpu"
    fi
    # niri is part of a desktop install unless --no-niri. --sddm and --niri install it anyway, including
    # on --shell-only, which still does not write a niri config. --sddm wins over --no-niri for the package.
    if [ "$sddm" = 1 ] || [ "$want_niri" = 1 ] || { [ "$desktop" = 1 ] && [ "$no_niri" = 0 ]; }; then
        packages="$packages niri"
    fi
    if [ "$wallpaper" = 1 ]; then
        packages="$packages awww"
    fi
    if [ "$sddm" = 1 ]; then
        packages="$packages sddm qt6-declarative qt6-5compat"
    fi

    ensure_helper
    # shellcheck disable=SC2086 # the list is split on purpose
    "$helper" -S --needed --noconfirm $packages
    if [ "$optional" = 1 ]; then
        # shellcheck disable=SC2086
        "$helper" -S --needed --noconfirm wl-clipboard wf-recorder matugen qt5ct qt6ct glib2 dconf wlsunset \
            xdg-utils xdg-terminal-exec networkmanager bluez upower power-profiles-daemon
        # the Controls tiles and the battery talk to these; NetworkManager is left to you, since it
        # replaces whatever manages the network now
        sudo systemctl enable --now bluetooth upower power-profiles-daemon
    fi
}

# clone or update $ref and cargo install it. The download path does not call this.
compile_tree() {
    if [ -f "$0" ] && [ -f "$(dirname "$0")/../dist/kanade.service" ]; then
        cd "$(dirname "$0")/.."
        dist=$(pwd)/dist
    else
        src="$data/kanade/src"
        if [ -d "$src/.git" ]; then
            git -C "$src" fetch -q --depth 1 origin "$ref"
            git -C "$src" checkout -q --force FETCH_HEAD
        else
            git clone -q --depth 1 --branch "$ref" "$repo" "$src"
        fi
        cd "$src"
        dist=$src/dist
    fi
    cargo install --locked --root "$root" --path .
}

# download kanade + checksum into $1. 0 verified, ready to install. Exits on a bad checksum or any
# download error other than a missing asset. Returns 1 only for HTTP 404, which the caller compiles.
fetch_binary() {
    dir=$1
    fetch "$release/kanade" "$dir/kanade" && status=0 || status=$?
    if [ "$status" = 2 ]; then
        echo "install-0.1 has no kanade asset (HTTP 404), compiling release/0.1" >&2
        return 1
    fi
    if [ "$status" != 0 ]; then
        exit 1
    fi
    fetch "$release/kanade.sha256" "$dir/kanade.sha256" && status=0 || status=$?
    if [ "$status" != 0 ]; then
        echo "failed: kanade.sha256 missing or not downloaded" >&2
        exit 1
    fi
    verify "$dir/kanade" "$dir/kanade.sha256" || exit 1

    rev=
    fetch "$release/kanade.rev" "$dir/kanade.rev" && status=0 || status=$?
    if [ "$status" = 0 ]; then
        rev=$(tr -d '[:space:]' < "$dir/kanade.rev")
        if [ -n "$rev" ]; then
            echo "kanade $rev"
        fi
    fi
    # absent, or a rev download that is not the binary: do not fail the verified binary
    case "$rev" in
        [0-9a-f][0-9a-f]*) tree=$rev ;;
        *) tree=release/0.1 ;;
    esac
    raw=https://raw.githubusercontent.com/0x1d1e/kanade/$tree
    mkdir -p "$dir/dist/niri"
    fetch_dist "$raw/dist/kanade.service" "$dir/dist/kanade.service" "$tree"
    fetch_dist "$raw/dist/kanade.png" "$dir/dist/kanade.png" "$tree"
    fetch_dist "$raw/dist/niri/config.kdl" "$dir/dist/niri/config.kdl" "$tree"
    dist=$dir/dist
}

fetch_dist() {
    fetch "$1" "$2" && status=0 || status=$?
    if [ "$status" != 0 ]; then
        echo "failed to download $(basename "$2") from $3" >&2
        exit 1
    fi
}

# piped, with a terminal, and without --yes: the TUI collects the toggles and runs this script again.
# A missing kanade-install asset continues here. A checksum mismatch does not.
launch_tui() {
    if ! command -v curl > /dev/null || ! command -v sha256sum > /dev/null; then
        echo "failed to find curl or sha256sum, continuing without the TUI" >&2
        return 0
    fi
    tmp=$(mktemp -d)
    if ! curl -fsSL "$script_url" -o "$tmp/install"; then
        echo "failed to save a copy of the install script, continuing without the TUI" >&2
        rm -rf "$tmp"
        return 0
    fi
    fetch "$release/kanade-install" "$tmp/kanade-install" && status=0 || status=$?
    if [ "$status" = 2 ]; then
        echo "install-0.1 has no kanade-install asset (HTTP 404), continuing without the TUI" >&2
        rm -rf "$tmp"
        return 0
    fi
    if [ "$status" != 0 ]; then
        rm -rf "$tmp"
        exit 1
    fi
    fetch "$release/kanade-install.sha256" "$tmp/kanade-install.sha256" && status=0 || status=$?
    if [ "$status" != 0 ]; then
        echo "failed: kanade-install.sha256 missing or not downloaded" >&2
        rm -rf "$tmp"
        exit 1
    fi
    if ! verify "$tmp/kanade-install" "$tmp/kanade-install.sha256"; then
        rm -rf "$tmp"
        exit 1
    fi
    chmod 755 "$tmp/kanade-install"
    set -- --script "$tmp/install"
    if [ "$desktop" = 0 ]; then
        set -- "$@" --shell-only
    fi
    if [ "$no_niri" = 1 ]; then
        set -- "$@" --no-niri
    fi
    if [ "$want_niri" = 1 ]; then
        set -- "$@" --niri
    fi
    if [ "$sddm" = 1 ]; then
        set -- "$@" --sddm
    fi
    if [ "$sddm_greeter_set" = 1 ]; then
        set -- "$@" --sddm-greeter "$sddm_greeter"
    fi
    if [ "$optional" = 1 ]; then
        set -- "$@" --optional
    fi
    # The TUI runs as a child rather than as this shell's replacement (`exec`), so the copy of this
    # script it reads is removed when it ends, however it ends
    trap 'rm -rf "$tmp"' EXIT
    status=0
    "$tmp/kanade-install" "$@" < /dev/tty > /dev/tty 2>&1 || status=$?
    exit "$status"
}

# an NVIDIA GPU beside another device. Xorg can start on the one with no screens; niri does not.
hybrid_nvidia() {
    nvidia=0
    devices=
    for dev in /sys/class/drm/card*/device; do
        [ -r "$dev/vendor" ] || continue
        vendor=$(cat "$dev/vendor")
        real=$(readlink -f "$dev" 2> /dev/null || printf '%s' "$dev")
        devices="$devices$real
"
        if [ "$vendor" = 0x10de ]; then
            nvidia=1
        fi
    done
    [ "$nvidia" = 1 ] || return 1
    count=$(printf '%s
' "$devices" | sort -u | awk 'NF { n++ } END { print n + 0 }')
    [ "$count" -ge 2 ]
}

# $1 path, $2 exact text without a trailing newline. Skip when the installed file already matches.
write_root_text() {
    dest=$1
    text=$2
    current=$(sudo cat "$dest" 2> /dev/null || true)
    if [ "$current" = "$text" ]; then
        return 0
    fi
    printf '%s\n' "$text" | sudo install -D -m 644 /dev/stdin "$dest"
}

# after $root/bin/kanade exists. Stops on failure, and does not point SDDM at a theme that is not installed.
# The shell never runs these. This script does, as it does for paru and the user unit.
setup_sddm() {
    echo "setting up SDDM"
    uid=$(id -u)
    gid=$(id -g)
    # Repair only the managed executable prefix and theme parent. Never recurse into the
    # separately user-owned backdrop directory or into unrelated themes.
    for dir in /usr/local/share/kanade-sddm /usr/local/share/kanade-sddm/themes; do
        if [ -L "$dir" ] || { [ -e "$dir" ] && [ ! -d "$dir" ]; }; then
            echo "failed: $dir is not a plain directory" >&2
            exit 1
        fi
        sudo install -d -o root -g root -m 755 "$dir"
        sudo chown root:root "$dir"
        sudo chmod 755 "$dir"
    done
    sudo install -d -o "$uid" -g "$gid" -m 755 /usr/local/share/kanade-sddm-data
    sudo "$root/bin/kanade" sddm setup
    "$root/bin/kanade" sddm sync

    meta=/usr/local/share/kanade-sddm/themes/kanade/metadata.desktop
    if [ ! -f "$meta" ]; then
        echo "failed: SDDM theme was not installed" >&2
        exit 1
    fi
    write_root_text /etc/sddm.conf.d/zz-kanade.conf '[Theme]
ThemeDir=/usr/local/share/kanade-sddm/themes
Current=kanade'
    # Report the effective selection using Kanade's config-order inspection. Never rewrite another
    # SDDM file automatically: a later user's or package drop-in may intentionally override ours.
    if ! "$root/bin/kanade" sddm status; then
        echo "note: SDDM's effective theme may be overridden; see the status above" >&2
    fi

    if [ "$sddm_greeter" = niri ]; then
        niri_bin=$(command -v niri || true)
        case "$niri_bin" in
            /*) ;;
            *) niri_bin=$(readlink -f "$niri_bin" 2> /dev/null || true) ;;
        esac
        case "$niri_bin" in
            /*) ;;
            *) echo "failed: niri is not on PATH" >&2; exit 1 ;;
        esac
        kdl=/usr/local/share/kanade-sddm/niri-greeter.kdl
        write_root_text "$kdl" 'layout {
    gaps 0
    border { off; }
    shadow { off; }
}
window-rule {
    open-fullscreen true
}'
        # not zz-kanade.conf: that file is [Theme] only. This one sorts before it.
        write_root_text /etc/sddm.conf.d/zy-kanade-greeter.conf "[General]
DisplayServer=wayland

[Wayland]
CompositorCommand=$niri_bin -c $kdl"
    fi

    if systemctl is-enabled --quiet sddm.service; then
        echo "sddm is already enabled; not started"
        return 0
    fi
    if [ -L /etc/systemd/system/display-manager.service ]; then
        target=$(readlink -f /etc/systemd/system/display-manager.service 2> /dev/null || true)
        name=$(basename "$target")
        if [ -n "$target" ] && [ "$name" != sddm.service ]; then
            sudo rm -f /etc/systemd/system/display-manager.service
        fi
    fi
    for dm in gdm lightdm lxdm greetd plasmalogin; do
        if systemctl is-enabled --quiet "$dm.service"; then
            sudo systemctl disable "$dm.service"
        fi
    done
    sudo systemctl enable sddm.service
    echo "enabled sddm for the next boot; not started"
}

# everything is in main(), so the shell has read the whole script before anything runs: a piped
# script's stdin is then free for sudo and the helper's questions
main() {
    piped=0
    have_tty=0
    if [ ! -t 0 ] && [ ! -f "$0" ]; then
        piped=1
    fi
    if (: < /dev/tty) 2> /dev/null; then
        have_tty=1
    fi

    optional=0
    desktop=1
    no_niri=0
    want_niri=0
    sddm=0
    sddm_greeter=keep
    sddm_greeter_set=0
    uninstall=0
    yes=0
    ref=release/0.1
    ref_set=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --optional) optional=1 ;;
            --shell-only) desktop=0 ;;
            --no-niri) no_niri=1 ;;
            --niri) want_niri=1 ;;
            --sddm) sddm=1 ;;
            --sddm-greeter)
                shift
                if [ $# -eq 0 ]; then
                    echo "$usage" >&2
                    exit 2
                fi
                case "$1" in
                    keep|niri) sddm_greeter=$1; sddm_greeter_set=1 ;;
                    *) echo "$usage" >&2; exit 2 ;;
                esac
                ;;
            --uninstall) uninstall=1 ;;
            --yes) yes=1 ;;
            --ref)
                shift
                if [ $# -eq 0 ]; then
                    echo "$usage" >&2
                    exit 2
                fi
                ref=$1
                ref_set=1
                ;;
            *) echo "$usage" >&2; exit 2 ;;
        esac
        shift
    done

    # --ref is the clone path only; a checkout builds that tree and is never fetched over
    if [ "$ref_set" = 1 ] && [ -f "$0" ] && [ -f "$(dirname "$0")/../dist/kanade.service" ]; then
        echo "--ref does not apply to a checkout, which builds that tree" >&2
        exit 2
    fi
    if [ "$ref_set" = 1 ] && [ "$uninstall" = 1 ]; then
        echo "--ref does not apply to --uninstall" >&2
        exit 2
    fi
    if [ "$ref_set" = 1 ] && ! ref_ok "$ref"; then
        echo "--ref takes one branch or tag name" >&2
        exit 2
    fi

    # --yes, --uninstall, --ref, or no terminal: do not download the TUI. Refuse before downloading
    # it, so a non-Arch or non-x86_64 machine never execs the binary.
    if [ "$piped" = 1 ] && [ "$have_tty" = 1 ] && [ "$yes" = 0 ] && [ "$uninstall" = 0 ] && [ "$ref_set" = 0 ]; then
        if ! command -v pacman > /dev/null; then
            echo "failed to find pacman, Kanade installs on Arch Linux and derivatives only" >&2
            exit 1
        fi
        refuse_machine
        launch_tui
    fi

    if [ "$piped" = 1 ]; then
        if [ "$have_tty" = 0 ]; then
            echo "failed to find a terminal for sudo and pacman, run this from a shell" >&2
            exit 1
        fi
        exec < /dev/tty
    fi

    config="${XDG_CONFIG_HOME:-$HOME/.config}"
    data="${XDG_DATA_HOME:-$HOME/.local/share}"
    # where the unit's ExecStart expects the binary, whatever CARGO_HOME or CARGO_INSTALL_ROOT say
    root="$HOME/.cargo"

    if [ "$uninstall" = 1 ]; then
        # niri's binds spawn kanade, the lock one included; without it they do nothing
        if grep -Eqs 'spawn[^/]*"kanade[ "]' "$config/niri/config.kdl"; then
            echo "warning: $config/niri/config.kdl still runs kanade, so its binds, locking included, stop working" >&2
            printf "remove Kanade anyway? [y/N] " >&2
            read -r answer || answer=n
            case "$answer" in
                [yY]*) ;;
                *) echo "kept Kanade; point those binds at another program first" >&2; exit 1 ;;
            esac
        fi
        if [ -e "$root/bin/kanade" ]; then
            cargo_installed=0
            if [ -f "$root/.crates2.json" ] && grep -q '"kanade"' "$root/.crates2.json"; then
                cargo_installed=1
            elif [ -f "$root/.crates.toml" ] && grep -q '"kanade"' "$root/.crates.toml"; then
                cargo_installed=1
            fi
            if [ "$cargo_installed" = 1 ]; then
                if ! command -v cargo > /dev/null; then
                    echo "failed to find cargo to uninstall $root/bin/kanade, remove it yourself" >&2
                    exit 1
                fi
                cargo uninstall --root "$root" kanade
            else
                rm -f "$root/bin/kanade"
            fi
        fi
        systemctl --user disable --now kanade.service || true
        # the unit is Kanade's, so the hand-edited copies beside it are kept: they are what a user
        # changed it to, and nothing else holds them
        rm -f "$config/systemd/user/kanade.service" \
            "$data/icons/hicolor/256x256/apps/kanade.png" "$data/bash-completion/completions/kanade" \
            "$config/fish/completions/kanade.fish" "$data/zsh/site-functions/_kanade"
        rm -rf "$data/kanade/src"
        systemctl --user daemon-reload

        # --sddm's root-owned files. Only the ones this script writes, named here: another theme's
        # overlay, /etc/sddm.conf and every other drop-in stay. A sudo that is refused leaves them
        # too, and the note below says which are still there
        sddm_files='/etc/sddm.conf.d/zz-kanade.conf /etc/sddm.conf.d/zy-kanade-greeter.conf
/usr/local/share/kanade-sddm/niri-greeter.kdl /usr/local/share/kanade-sddm/themes/kanade
/usr/local/share/kanade-sddm-data/backdrop.png'
        sddm_present=
        for file in $sddm_files; do
            if [ -e "$file" ] || [ -L "$file" ]; then
                sddm_present="$sddm_present $file"
            fi
        done
        if [ -n "$sddm_present" ]; then
            echo "removing the SDDM files the installer wrote (sudo):$sddm_present"
            # shellcheck disable=SC2086 # the list is split on purpose
            sudo rm -f $sddm_present || true
            # only when empty: another theme's overlay in themes/ stays, and so does the directory
            sudo rmdir /usr/local/share/kanade-sddm/themes /usr/local/share/kanade-sddm \
                /usr/local/share/kanade-sddm-data 2> /dev/null || true
        fi
        sddm_left=
        for file in $sddm_files; do
            if [ -e "$file" ] || [ -L "$file" ]; then
                sddm_left="$sddm_left $file"
            fi
        done

        echo "removed Kanade; kept your configs, the systemd unit copies (kanade.service.bak*), niri's kanade.kdl include and the packages"
        if [ -n "$sddm_left" ]; then
            echo "left these root-owned SDDM files, which sudo could not remove; remove them yourself:" >&2
            for file in $sddm_left; do
                echo "  sudo rm -f $file" >&2
            done
            echo "  (they point SDDM at Kanade's theme; without them SDDM falls back to its own)" >&2
        elif [ -n "$sddm_present" ]; then
            echo "removed the SDDM files it wrote; /etc/sddm.conf and other drop-ins are untouched"
        fi
        exit 0
    fi

    # the libraries and tools come from docs/wiki/Installation.md
    if ! command -v pacman > /dev/null; then
        echo "failed to find pacman, Kanade installs on Arch Linux and derivatives only" >&2
        exit 1
    fi

    checkout=0
    if [ -f "$0" ] && [ -f "$(dirname "$0")/../dist/kanade.service" ]; then
        checkout=1
    fi

    compile=0
    work=
    if [ "$checkout" = 1 ] || [ "$ref_set" = 1 ]; then
        compile=1
    else
        refuse_machine
        if ! command -v curl > /dev/null || ! command -v sha256sum > /dev/null; then
            echo "failed to find curl or sha256sum" >&2
            exit 1
        fi
        work=$(mktemp -d)
        trap 'rm -rf "$work"' EXIT
        if ! fetch_binary "$work"; then
            compile=1
        fi
    fi

    install_packages

    if [ "$compile" = 1 ]; then
        compile_tree
    else
        install -Dm755 "$work/kanade" "$root/bin/kanade"
    fi

    if [ "$sddm" = 1 ]; then
        if [ "$sddm_greeter_set" = 0 ] && hybrid_nvidia; then
            sddm_greeter=niri
        fi
        setup_sddm
    fi

    # the old unit is kept when it differs, so a hand edit is not lost
    unit="$config/systemd/user/kanade.service"
    if [ -e "$unit" ] && ! cmp -s "$dist/kanade.service" "$unit"; then
        backup="$unit.bak.$(date +%Y%m%d%H%M%S)"
        cp "$unit" "$backup"
        echo "replaced $unit, the old one is $backup; customize with: systemctl --user edit kanade.service"
    fi
    install -Dm644 "$dist/kanade.service" "$unit"
    install -Dm644 "$dist/kanade.png" "$data/icons/hicolor/256x256/apps/kanade.png"

    # from the verbs of the binary just built, so they never lag it; zsh needs the directory in its fpath
    mkdir -p "$data/bash-completion/completions" "$config/fish/completions" "$data/zsh/site-functions"
    "$root/bin/kanade" completions bash > "$data/bash-completion/completions/kanade"
    "$root/bin/kanade" completions fish > "$config/fish/completions/kanade.fish"
    "$root/bin/kanade" completions zsh > "$data/zsh/site-functions/_kanade"

    # A config of yours is never replaced. Explicit Niri or SDDM selection means Niri is the
    # chosen session even when the rest of the desktop packages were skipped.
    if { [ "$no_niri" = 0 ] && { [ "$desktop" = 1 ] || [ "$want_niri" = 1 ]; }; } || [ "$sddm" = 1 ]; then
        if [ -e "$config/niri/config.kdl" ]; then
            echo "kept $config/niri/config.kdl, dist/niri/config.kdl is the default"
            echo "  add this as its last line for appearance.sync: include optional=true \"kanade.kdl\""
        else
            install -Dm644 "$dist/niri/config.kdl" "$config/niri/config.kdl"
            echo "installed $config/niri/config.kdl"
        fi
    fi

    systemctl --user daemon-reload
    systemctl --user enable kanade.service

    # niri.service is the session entry point and pulls in graphical-session.target.
    # Restart now when niri is already active; otherwise its WantedBy link starts Kanade at login.
    if systemctl --user is-active --quiet niri.service; then
        systemctl --user restart kanade.service
    elif [ "$desktop" = 1 ] || [ "$want_niri" = 1 ] || [ "$sddm" = 1 ]; then
        echo "installed; start niri from this TTY with: niri-session"
        echo "  Kanade starts with it, Mod+T opens kitty. To start niri at login on tty1, add to"
        echo "  ~/.bash_profile or ~/.zprofile: [ \"\$(tty)\" = /dev/tty1 ] && exec niri-session"
    else
        echo "installed; Kanade starts with niri"
    fi

    # the niri binds run `kanade`, so it has to be on the session's PATH, which niri-session takes
    # from the login shell
    case ":$PATH:" in
        *":$HOME/.cargo/bin:"*) ;;
        *) echo "warning: ~/.cargo/bin is not in PATH, add to ~/.profile: export PATH=\"\$HOME/.cargo/bin:\$PATH\"" >&2 ;;
    esac

    # only one notification daemon can own the bus name, so the other one has to go
    if command -v busctl > /dev/null; then
        owner=$(busctl --user status org.freedesktop.Notifications 2> /dev/null | sed -n 's/^Comm=//p')
        if [ -n "$owner" ] && [ "$owner" != "kanade" ]; then
            echo "warning: $owner is the notification daemon, stop it and keep it from starting" >&2
            echo "  (systemctl --user disable --now $owner, spawn-at-startup in niri's config)" >&2
        fi
    fi

    echo "done, 'kanade doctor' checks the setup"
}

# on the same line, so a piped shell exits here instead of reading on from the terminal main took
main "$@"; exit
