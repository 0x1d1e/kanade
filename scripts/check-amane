#!/usr/bin/env python3
"""Fail unless the `amane` CLI on PATH embeds the Amane revision pinned in Cargo.toml.

`amane dev` ignores Cargo.toml and builds against the library embedded in the CLI, so
cargo (fmt/clippy/test) and `amane dev` can silently use different revisions. This compares
the embedded library files (src/**, Cargo.toml, Cargo.lock, the set cli/build.rs embeds)
byte for byte against the pinned checkout, whatever way the CLI was installed.
"""

import json
import shutil
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent

metadata = json.loads(
    subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--manifest-path", root / "Cargo.toml"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
)

pinned = next(package for package in metadata["packages"] if package["name"] == "amane")
source = pinned["source"]  # git+<url>?rev=<rev>#<sha>
url, _, sha = source.removeprefix("git+").partition("#")
library = Path(pinned["manifest_path"]).parent
install = f"cargo install --git {url.split('?')[0]} --rev {sha} --locked amane-cli"


def fail(message):
    sys.exit(f"check-amane: {message}\nfix: {install}")


cli = shutil.which("amane")

if cli is None:
    fail("`amane` not found on PATH")

binary = Path(cli).read_bytes()

files = [library / "Cargo.toml", library / "Cargo.lock", *sorted((library / "src").rglob("*"))]

stale = [
    str(file.relative_to(library))
    for file in files
    if file.is_file() and file.read_bytes() not in binary
]

if stale:
    fail(f"{cli} does not embed pinned Amane {sha[:8]}; differing files: {', '.join(stale[:5])}")

print(f"check-amane: {cli} embeds pinned Amane {sha[:8]}")
