#!/bin/sh
# the shell's memory (#198) at Rest, with each Surface open and locked, in MiB; see docs/memory.md
# usage: scripts/memory [sample LABEL]; measures the shell $UNIT runs, kanade-memory by default,
# and $KANADE is the CLI, target/debug/kanade by default
set -e
kanade=${KANADE:-target/debug/kanade}
unit=${UNIT:-kanade-memory}
awk=$(dirname "$(readlink -f "$0")")/memory.awk

# anything else would run the whole scenario, which locks the session
case $1 in
sample | '') ;;
*)
    echo "usage: scripts/memory [sample LABEL]" >&2
    exit 2
    ;;
esac

# the unit's own cgroup holds the shell and its helpers, and nothing else
main_pid=$(systemctl --user show -p MainPID --value "$unit")
if [ "${main_pid:-0}" = 0 ]; then
    echo "memory: $unit runs no shell" >&2
    exit 1
fi
cgroup=/sys/fs/cgroup$(systemctl --user show -p ControlGroup --value "$unit")

select_renderer() {
    pid=$main_pid
    if [ "$(cat "/proc/$main_pid/comm" 2> /dev/null)" != kanade-recover ]; then
        return
    fi

    pid=
    children=$(cat "/proc/$main_pid/task/$main_pid/children" 2> /dev/null) || children=
    for child in $children; do
        grep -qx "$child" "$cgroup/cgroup.procs" || continue
        [ "$(readlink "/proc/$child/exe")" = "$(readlink "/proc/$main_pid/exe")" ] || continue
        tr '\000' '\n' < "/proc/$child/cmdline" 2> /dev/null | grep -qx -- --umbriel-shell || continue
        if [ -n "$pid" ]; then
            echo "memory: $unit has more than one recovery renderer" >&2
            exit 1
        fi
        pid=$child
    done
    if [ -z "$pid" ]; then
        echo "memory: $unit recovery parent has no renderer to sample" >&2
        exit 1
    fi
}

header() {
    printf "%-14s %7s %7s %7s %7s %7s %7s %7s | %7s %7s %7s %7s %7s %7s %7s\n" "" \
        rss pss anon swap file gpu gpu-res cgroup peak anon cache shmem slab-r others
}

gone() {
    echo "memory: the shell, pid $pid, is gone" >&2
    exit 1
}

interrupted() {
    echo "memory: incomplete sample for renderer pid $pid: $1" >&2
    exit 1
}

sample() {
    select_renderer
    identity=$(awk '{ sub(/^.*\) /, ""); print $20 }' "/proc/$pid/stat" 2> /dev/null) || interrupted "process identity unavailable"
    executable=$(readlink "/proc/$pid/exe") || interrupted "executable unavailable"
    rollup=$(cat "/proc/$pid/smaps_rollup" 2> /dev/null) || interrupted "memory rollup unavailable"
    for key in Rss Pss Anonymous Pss_File; do
        printf '%s\n' "$rollup" | grep -Eq "^$key:[[:space:]]+[0-9]+[[:space:]]+kB$" || interrupted "$key missing from rollup"
    done
    status=$(cat "/proc/$pid/status" 2> /dev/null) || interrupted "process status unavailable"
    printf '%s\n' "$status" | grep -Eq '^VmSwap:[[:space:]]+[0-9]+[[:space:]]+kB$' || interrupted "VmSwap unavailable"

    # An accessible fd directory with no DRM descriptors is a real zero; a failed scan is not.
    dri=$(find "/proc/$pid/fd" -lname '/dev/dri/*' -printf "/proc/$pid/fdinfo/%f\n" 2> /dev/null) || interrupted "GPU descriptors unavailable"
    gpu_info=$(
        readable=0
        for file in $dri; do
            if fdinfo=$(cat "$file" 2> /dev/null); then
                printf '%s\n' "$fdinfo" | sed "s|^|fdinfo $file |"
                readable=$((readable + 1))
            elif [ -e "$file" ]; then
                exit 1
            fi
        done
        [ -z "$dri" ] || [ "$readable" -gt 0 ]
    ) || interrupted "GPU fdinfo unavailable"

    processes=$(cat "$cgroup/cgroup.procs") || interrupted "unit processes unavailable"
    helpers=$(
        for other in $processes; do
            [ "$other" != "$pid" ] || continue
            sed -n 's/^Pss:/others/p' "/proc/$other/smaps_rollup" 2> /dev/null || true
        done
    )
    cg_stat=$(cat "$cgroup/memory.stat") || interrupted "cgroup statistics unavailable"
    for key in anon file shmem slab_reclaimable; do
        printf '%s\n' "$cg_stat" | grep -Eq "^$key [0-9]+$" || interrupted "$key missing from cgroup statistics"
    done
    cg_current=$(cat "$cgroup/memory.current") || interrupted "cgroup memory unavailable"
    case $cg_current in
    '' | *[!0-9]*) interrupted "invalid cgroup memory" ;;
    esac
    # memory.peak is optional on kernels before Linux 5.19.
    cg_peak=$(cat "$cgroup/memory.peak" 2> /dev/null) || cg_peak=

    current_identity=$(awk '{ sub(/^.*\) /, ""); print $20 }' "/proc/$pid/stat" 2> /dev/null) || interrupted "renderer exited during collection"
    [ -n "$identity" ] && [ "$identity" = "$current_identity" ] || interrupted "renderer changed during collection"
    [ "$executable" = "$(readlink "/proc/$pid/exe")" ] || interrupted "renderer executable changed during collection"
    grep -qx "$pid" "$cgroup/cgroup.procs" || interrupted "renderer left the unit during collection"

    {
        printf '%s\n' "$rollup" | sed 's/^/rollup /'
        printf '%s\n' "$status" | sed -n 's/^VmSwap:/status VmSwap:/p'
        printf '%s\n' "$gpu_info" "$helpers"
        printf '%s\n' "$cg_stat" | sed 's/^/cgroup /'
        printf 'cgroup current %s\n' "$cg_current"
        [ -z "$cg_peak" ] || printf 'cgroup peak %s\n' "$cg_peak"
    } | awk -v label="$1" -f "$awk"
}

if [ "$1" = sample ]; then
    header
    sample "${2:-now}"
    exit
fi

# a Surface allocates as it draws: give it time to settle, still within the 5 s HOLD
step() {
    label=$1
    shift
    "$kanade" "$@" > /dev/null
    sleep 2
    sample "$label"
}

header
sample rest
for surface in controls media notifications launcher tray clipboard calendar weather; do
    step "$surface" "$surface" open
done
step collapse island collapse
step settings settings open
step closed settings close

# every monitor shows a lock screen; only the user's password ends it, even when `lock` fails
echo "memory: locking; type your password to unlock" >&2
"$kanade" lock
sleep 2
sample locked
# `lock status` ends with `unlocked` once a password was accepted
until "$kanade" lock status 2> /dev/null | tail -n 1 | grep -qx unlocked; do
    kill -0 "$pid" 2> /dev/null || gone
    sleep 1
done
sleep 2
sample unlocked
