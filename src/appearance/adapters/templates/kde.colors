# Kanade appearance sync: wallpaper colors through Matugen, rewritten on each change
# KDE apps outside Plasma (Dolphin, Kate, Okular) take this scheme instead of Breeze, through
# kdeglobals' [UiSettings] ColorScheme=Kanade; positive and neutral stay Breeze's green and orange

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{surface_container_highest}}
BackgroundNormal={{surface_container_high}}
DecorationFocus={{primary}}
DecorationHover={{primary}}
ForegroundActive={{primary}}
ForegroundInactive={{on_surface_variant}}
ForegroundLink={{primary}}
ForegroundNegative={{error}}
ForegroundNeutral=#f67400
ForegroundNormal={{on_surface}}
ForegroundPositive=#27ae60
ForegroundVisited={{tertiary}}

[Colors:Complementary]
BackgroundAlternate={{surface_container_low}}
BackgroundNormal={{surface_container_lowest}}
DecorationFocus={{primary}}
DecorationHover={{primary}}
ForegroundActive={{primary}}
ForegroundInactive={{on_surface_variant}}
ForegroundLink={{primary}}
ForegroundNegative={{error}}
ForegroundNeutral=#f67400
ForegroundNormal={{on_surface}}
ForegroundPositive=#27ae60
ForegroundVisited={{tertiary}}

[Colors:Header]
BackgroundAlternate={{surface_container_high}}
BackgroundNormal={{surface_container}}
DecorationFocus={{primary}}
DecorationHover={{primary}}
ForegroundActive={{primary}}
ForegroundInactive={{on_surface_variant}}
ForegroundLink={{primary}}
ForegroundNegative={{error}}
ForegroundNeutral=#f67400
ForegroundNormal={{on_surface}}
ForegroundPositive=#27ae60
ForegroundVisited={{tertiary}}

[Colors:Header][Inactive]
BackgroundAlternate={{surface_container}}
BackgroundNormal={{surface}}
DecorationFocus={{primary}}
DecorationHover={{primary}}
ForegroundActive={{primary}}
ForegroundInactive={{on_surface_variant}}
ForegroundLink={{primary}}
ForegroundNegative={{error}}
ForegroundNeutral=#f67400
ForegroundNormal={{on_surface}}
ForegroundPositive=#27ae60
ForegroundVisited={{tertiary}}

[Colors:Selection]
BackgroundAlternate={{primary_container}}
BackgroundNormal={{primary}}
DecorationFocus={{primary}}
DecorationHover={{primary}}
ForegroundActive={{on_primary}}
ForegroundInactive={{on_primary}}
ForegroundLink={{on_primary}}
ForegroundNegative={{on_primary}}
ForegroundNeutral={{on_primary}}
ForegroundNormal={{on_primary}}
ForegroundPositive={{on_primary}}
ForegroundVisited={{on_primary}}

[Colors:Tooltip]
BackgroundAlternate={{surface_container_high}}
BackgroundNormal={{surface_container_highest}}
DecorationFocus={{primary}}
DecorationHover={{primary}}
ForegroundActive={{primary}}
ForegroundInactive={{on_surface_variant}}
ForegroundLink={{primary}}
ForegroundNegative={{error}}
ForegroundNeutral=#f67400
ForegroundNormal={{on_surface}}
ForegroundPositive=#27ae60
ForegroundVisited={{tertiary}}

[Colors:View]
BackgroundAlternate={{surface_container}}
BackgroundNormal={{surface_container_low}}
DecorationFocus={{primary}}
DecorationHover={{primary}}
ForegroundActive={{primary}}
ForegroundInactive={{on_surface_variant}}
ForegroundLink={{primary}}
ForegroundNegative={{error}}
ForegroundNeutral=#f67400
ForegroundNormal={{on_surface}}
ForegroundPositive=#27ae60
ForegroundVisited={{tertiary}}

[Colors:Window]
BackgroundAlternate={{surface_container}}
BackgroundNormal={{surface}}
DecorationFocus={{primary}}
DecorationHover={{primary}}
ForegroundActive={{primary}}
ForegroundInactive={{on_surface_variant}}
ForegroundLink={{primary}}
ForegroundNegative={{error}}
ForegroundNeutral=#f67400
ForegroundNormal={{on_surface}}
ForegroundPositive=#27ae60
ForegroundVisited={{tertiary}}

[General]
ColorScheme=Kanade
Name=Kanade

[KDE]
contrast=4
